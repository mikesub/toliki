# Rotation for the harness cron logs — the three appenders in etc/dispatch.cron.
# bin/provision.sh installs this at /etc/logrotate.d/harness-logs; Ubuntu's
# stock daily logrotate run picks it up from there, no timer of our own.
#
# Monthly on purpose: the concern is unbounded growth, not disk pressure — a
# month of one-minute ticks across three repos is ~25 MB uncompressed (dispatch
# ~4 lines a tick, merge ~3, reap ~2), and six compressed rotations ≈ half a
# year of history. That survived the move from five-minute to one-minute ticks
# with room to spare; what a month of them costs is skimmability, not disk, so
# reach for grep rather than a shorter rotation if these get hard to read.
#
# No copytruncate: nothing holds these files open — each cron tick appends via
# its own >> and exits, so rename-and-recreate loses no lines (the next tick's
# >> recreates the file). A merge-worker still draining across the rotation
# keeps appending to the renamed file through its open fd; delaycompress leaves
# that newest rotation uncompressed for one cycle so those lines land intact.
#
# su: logrotate runs as root and refuses to rotate files in a directory
# writable by a non-root user (/home/ubuntu) unless told which user to act as.
#
# missingok: the logs only exist once etc/dispatch.cron is installed, which is
# a deliberate manual step — this config must be harmless on a box that hasn't
# taken it.
/home/ubuntu/dispatch.log /home/ubuntu/reap.log /home/ubuntu/merge.log {
	monthly
	rotate 6
	compress
	delaycompress
	missingok
	notifempty
	su ubuntu ubuntu
}
